GEMINI_API_KEY=

# Get a free key at https://resend.com — used to send the "you're connected
# with Pinkku" welcome email when a new account signs up.
RESEND_API_KEY=

# Optional. Must be a verified sender/domain in your Resend account.
# Defaults to Resend's shared sandbox sender if left blank.
RESEND_FROM_EMAIL=Pinkku <onboarding@resend.dev>

PORT=3000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add this redirect URI there:
#   http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Create a bot with @BotFather on Telegram (send /newbot). This is the one
# shared Pinkku bot — users connect their own Telegram account by messaging it,
# not by providing their own token.
TELEGRAM_BOT_TOKEN=

# Any random string. Telegram echoes this back in a header on every webhook
# call so /api/telegram/webhook can reject requests that didn't actually come
# from Telegram. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# After setting it (or changing it), re-run scripts/set-telegram-webhook.ts.
TELEGRAM_WEBHOOK_SECRET=

# developers.facebook.com > your app > Facebook Login for Business > Settings.
# Add this redirect URI there:
#   http://localhost:3000/api/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback

# developers.tiktok.com > your app > Login Kit. Add this redirect URI there:
#   http://localhost:3000/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback
